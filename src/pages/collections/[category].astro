---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import BreadcrumbLd from '../../components/jsonld/BreadcrumbLd.astro';
import ItemListLd from '../../components/jsonld/ItemListLd.astro';
import { getSettings } from '../../lib/settings';
import { categories, byCategory } from '../../lib/products';
import { excerpt } from '../../lib/format';

export async function getStaticPaths() {
  const { categories } = await import('../../lib/products');
  const cats = await categories();
  return cats.map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const settings = await getSettings();
const products = await byCategory(category.id);
const cats = await categories();

// The body copy is what makes a category page rank instead of being a thin,
// content-less grid. PLAN.md §5.6 / §10.4.
const { Content } = await render(category);

const crumbs = [
  { label: 'Home', href: '/' },
  { label: settings.labels.allJewellery, href: '/products/' },
  { label: category.data.title },
];
---

<BaseLayout
  title={category.data.seo?.title ?? category.data.title}
  description={category.data.seo?.description ?? excerpt(category.body ?? '')}
>
  <Breadcrumbs slot="breadcrumbs" crumbs={crumbs} />

  <section class="band band--tight">
    <div class="wrap">
      <div class="band-head">
        <div>
          <p class="jd-label">
            {products.length} {products.length === 1 ? 'design' : 'designs'}
          </p>
          <h1>{category.data.title}</h1>
        </div>
        <a class="more" href="/products/">{settings.labels.allJewellery} →</a>
      </div>

      <div class="cat-intro">
        <Content />
      </div>
    </div>
  </section>

  <section class="band band--sand">
    <div class="wrap">
      <nav class="chips" aria-label="Filter by category">
        <a class="chip" href="/products/">All</a>
        {
          cats.map((c) => (
            <a
              class="chip"
              href={`/collections/${c.id}/`}
              aria-current={c.id === category.id ? 'true' : undefined}
            >
              {c.data.title}
            </a>
          ))
        }
      </nav>

      {
        products.length > 0 ? (
          <div class="grid">
            {products.map((product, i) => <ProductCard product={product} eager={i < 3} />)}
          </div>
        ) : (
          <p class="empty">{settings.labels.emptyCategory}</p>
        )
      }
    </div>
  </section>

  <BreadcrumbLd crumbs={crumbs} />
  {products.length > 0 && <ItemListLd products={products} name={category.data.title} />}
</BaseLayout>
