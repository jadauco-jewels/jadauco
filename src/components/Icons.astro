---
/**
 * Line-art stand-ins for photography, plus the WhatsApp glyph. Defined once per
 * page as a hidden <symbol> sheet and referenced with <use>, so a grid of thirty
 * tiles costs one copy of the path data rather than thirty.
 *
 * Every one of these is a placeholder for a real photograph: cream or sand
 * ground, soft daylight, one piece per frame — brand-kit/GUIDELINES.md.
 */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="a-necklace" viewBox="0 0 240 200">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M26 22C26 128 214 128 214 22" /><path d="M48 24C48 110 192 110 192 24" />
        <circle cx="55" cy="84" r="5" /><circle cx="185" cy="84" r="5" />
        <circle cx="88" cy="101" r="4.5" /><circle cx="152" cy="101" r="4.5" />
        <circle cx="120" cy="104" r="14" /><circle cx="120" cy="104" r="5.5" />
        <path d="M120 119l-9 14 9 19 9-19z" /><path d="M96 96l-6 16M144 96l6 16" />
      </g>
    </symbol>

    <symbol id="a-pendant" viewBox="0 0 240 200">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M34 20C34 96 120 112 120 112" /><path d="M206 20C206 96 120 112 120 112" />
        <circle cx="70" cy="78" r="4.5" /><circle cx="170" cy="78" r="4.5" />
        <circle cx="120" cy="120" r="8" />
        <circle cx="120" cy="152" r="24" /><circle cx="120" cy="152" r="10" />
        <path d="M120 176l-8 13 8 17 8-17z" />
      </g>
    </symbol>

    <symbol id="a-jhumka" viewBox="0 0 200 200">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="100" cy="24" r="10" /><path d="M100 34v9" /><circle cx="100" cy="50" r="6" />
        <path d="M58 122c0-38 19-61 42-61s42 23 42 61Z" />
        <path d="M74 120c0-26 11-42 26-42s26 16 26 42" /><path d="M54 122h92" />
        <circle cx="100" cy="98" r="7.5" />
        <circle cx="62" cy="137" r="5" /><circle cx="75" cy="144" r="5" /><circle cx="88" cy="149" r="5" />
        <circle cx="100" cy="151" r="5" /><circle cx="112" cy="149" r="5" /><circle cx="125" cy="144" r="5" />
        <circle cx="138" cy="137" r="5" />
      </g>
    </symbol>

    <symbol id="a-bangle" viewBox="0 0 200 200">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <circle cx="100" cy="104" r="70" /><circle cx="100" cy="104" r="56" />
        <circle cx="100" cy="104" r="48" stroke-width="1.8" stroke-dasharray="2 10" />
        <circle cx="100" cy="34" r="11" /><path d="M100 23v22M89 34h22" />
        <circle cx="46" cy="140" r="4" /><circle cx="154" cy="140" r="4" />
        <circle cx="31" cy="86" r="4" /><circle cx="169" cy="86" r="4" />
      </g>
    </symbol>

    <symbol id="a-tikka" viewBox="0 0 200 200">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M100 10v56" /><circle cx="100" cy="18" r="4" /><circle cx="100" cy="34" r="4" /><circle cx="100" cy="50" r="4" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(45 100 102)" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(90 100 102)" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(135 100 102)" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(180 100 102)" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(225 100 102)" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(270 100 102)" />
        <ellipse cx="100" cy="72" rx="6.5" ry="11" transform="rotate(315 100 102)" />
        <circle cx="100" cy="102" r="16" /><circle cx="100" cy="102" r="6.5" />
        <path d="M100 131v8" /><path d="M100 139l-8 13 8 19 8-19z" />
      </g>
    </symbol>

    <symbol id="a-ring" viewBox="0 0 200 200">
      <g fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="100" cy="128" r="50" /><circle cx="100" cy="128" r="41" stroke-width="1.8" />
        <path d="M68 62h64l-32 40z" /><path d="M68 62l32 12 32-12M100 74v28" />
        <path d="M78 100l-8 14M122 100l8 14" />
      </g>
    </symbol>

    <symbol id="a-payal" viewBox="0 0 240 160">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
        <path d="M22 52c40 42 156 42 196 0" /><path d="M22 66c40 42 156 42 196 0" />
        <path d="M54 92v-7M88 104v-7M120 108v-7M152 104v-7M186 92v-7" />
        <circle cx="54" cy="99" r="6" /><circle cx="88" cy="111" r="6" /><circle cx="120" cy="115" r="6" />
        <circle cx="152" cy="111" r="6" /><circle cx="186" cy="99" r="6" />
      </g>
    </symbol>

    <symbol id="a-haar" viewBox="0 0 240 220">
      <g fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M32 18C32 104 208 104 208 18" /><path d="M18 20C18 150 222 150 222 20" />
        <circle cx="120" cy="132" r="14" /><circle cx="120" cy="132" r="5.5" />
        <path d="M120 146l-9 14 9 19 9-19z" />
        <circle cx="74" cy="116" r="7.5" /><path d="M74 124v12" /><circle cx="74" cy="142" r="4" />
        <circle cx="166" cy="116" r="7.5" /><path d="M166 124v12" /><circle cx="166" cy="142" r="4" />
        <circle cx="42" cy="76" r="4.5" /><circle cx="198" cy="76" r="4.5" />
        <circle cx="120" cy="86" r="5.5" />
      </g>
    </symbol>

    <symbol id="i-wa" viewBox="0 0 24 24">
      <path
        fill="currentColor"
        d="M12.04 2C6.6 2 2.2 6.4 2.2 11.84c0 1.9.5 3.68 1.4 5.22L2 22l5.06-1.56a9.8 9.8 0 0 0 4.98 1.36h.01c5.43 0 9.84-4.4 9.84-9.84C21.89 6.4 17.48 2 12.04 2m5.72 13.9c-.24.68-1.42 1.32-1.95 1.36-.5.05-1.13.07-1.83-.11-.42-.13-.96-.31-1.65-.6-2.9-1.26-4.8-4.2-4.94-4.4-.15-.2-1.19-1.58-1.19-3.02 0-1.43.75-2.14 1.02-2.43.27-.29.58-.36.78-.36l.56.01c.18 0 .42-.07.66.5.24.59.83 2.02.9 2.17.07.15.12.32.02.51-.1.2-.15.32-.29.49l-.44.51c-.15.14-.3.3-.13.59.17.29.75 1.24 1.61 2 1.11.99 2.04 1.3 2.33 1.44.29.15.46.12.63-.07.17-.2.73-.85.92-1.14.2-.29.39-.24.66-.15.27.1 1.7.8 1.99.95.29.15.48.22.55.34.07.12.07.68-.17 1.35"
      />
    </symbol>
  </defs>
</svg>
